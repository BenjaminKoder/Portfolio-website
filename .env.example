# Kopier til .env.local for lokal utvikling, og legg de samme verdiene inn under
# Settings → Environment Variables i Vercel. .env.local skal aldri committes.

# AI-assistenten (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Kontaktskjemaet (resend.com → API Keys). Avsenderen må være på et verifisert domene.
RESEND_API_KEY=
